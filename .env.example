DISCORD_TOKEN=your_token_here
DISCORD_PREFIX=!your_prefix_here
DISCORD_GUILD_ID=your_server_id_here
VOICE_CONNECT_TIMEOUT_SEC=30
VOICE_CONNECT_RETRIES=3
VOICE_RETRY_BACKOFF_SEC=2
BOT_LOG_LEVEL=INFO
# Seconds before a yt-dlp search or extraction is abandoned
SEARCH_TIMEOUT_SEC=20
# How many search hits to keep as fallbacks when the top result is unplayable
SEARCH_CANDIDATES=5
# Optional escape hatch: force specific yt-dlp YouTube player clients (e.g. android,web).
# Leave empty to use yt-dlp's own selection, which is the more reliable default.
YTDLP_PLAYER_CLIENTS=
